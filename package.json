{
  "name": "about-corwin",
  "version": "1.0.0",
  "private": true,
  "description": "aboutcorwin.com: built by build.py (Python); node is only for the checks.",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "python3 build.py",
    "test": "sh tests/run.sh",
